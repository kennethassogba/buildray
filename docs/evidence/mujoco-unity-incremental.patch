+# Buildray: opt-in unity experiment, validated for the measured configuration.
+option(BUILDRAY_UNITY "Enable the measured unity build on mujoco" OFF)
+if(BUILDRAY_UNITY)
+  if(NOT TARGET mujoco)
+    message(FATAL_ERROR "Unity target does not exist")
+  endif()
+  get_target_property(_buildray_unity_type mujoco TYPE)
+  get_target_property(_buildray_unity_imported mujoco IMPORTED)
+  get_target_property(_buildray_unity_alias mujoco ALIASED_TARGET)
+  if(_buildray_unity_imported OR _buildray_unity_alias OR NOT _buildray_unity_type
+     MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
+    message(FATAL_ERROR "Unity requires a local compiled target")
+  endif()
+  set_source_files_properties("${CMAKE_CURRENT_SOURCE_DIR}/plugin/gmsh_decoder/gmsh_decoder.cc" TARGET_DIRECTORY mujoco PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+  set_source_files_properties("${CMAKE_CURRENT_SOURCE_DIR}/plugin/obj_decoder/obj_decoder.cc" TARGET_DIRECTORY mujoco PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+  set_source_files_properties("${CMAKE_CURRENT_SOURCE_DIR}/plugin/stl_decoder/stl_decoder.cc" TARGET_DIRECTORY mujoco PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+  set_source_files_properties("${CMAKE_CURRENT_SOURCE_DIR}/src/engine/engine_collision_driver.c" TARGET_DIRECTORY mujoco PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+  set_source_files_properties("${CMAKE_CURRENT_SOURCE_DIR}/src/engine/engine_collision_flex.c" TARGET_DIRECTORY mujoco PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+  set_source_files_properties("${CMAKE_CURRENT_SOURCE_DIR}/src/engine/engine_collision_gjk.c" TARGET_DIRECTORY mujoco PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+  set_source_files_properties("${CMAKE_CURRENT_SOURCE_DIR}/src/engine/engine_collision_primitive.c" TARGET_DIRECTORY mujoco PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+  set_source_files_properties("${CMAKE_CURRENT_SOURCE_DIR}/src/engine/engine_crossplatform.cc" TARGET_DIRECTORY mujoco PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+  set_source_files_properties("${CMAKE_CURRENT_SOURCE_DIR}/src/user/user_composite.cc" TARGET_DIRECTORY mujoco PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+  set_source_files_properties("${CMAKE_CURRENT_SOURCE_DIR}/src/user/user_flexcomp.cc" TARGET_DIRECTORY mujoco PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+  set_source_files_properties("${CMAKE_CURRENT_SOURCE_DIR}/src/user/user_mesh.cc" TARGET_DIRECTORY mujoco PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+  set_source_files_properties("${CMAKE_CURRENT_SOURCE_DIR}/src/user/user_model.cc" TARGET_DIRECTORY mujoco PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+  set_target_properties(mujoco PROPERTIES
+    UNITY_BUILD ON UNITY_BUILD_MODE BATCH UNITY_BUILD_BATCH_SIZE 4)
+endif()
