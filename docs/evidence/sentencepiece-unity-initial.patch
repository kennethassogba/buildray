--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -242,3 +242,20 @@
 set(CPACK_DEBIAN_PACKAGE_MAINTAINER "Taku Kudo")
 set(CPACK_SOURCE_IGNORE_FILES "/build/;/.git/;/dist/;/sdist/;~$;${CPACK_SOURCE_IGNORE_FILES}")
 include(CPack)
+
+# Buildray: opt-in unity experiment, validated for the measured configuration.
+option(BUILDRAY_UNITY "Enable the measured unity build on sentencepiece-static" OFF)
+if(BUILDRAY_UNITY)
+  if(NOT TARGET sentencepiece-static)
+    message(FATAL_ERROR "Unity target does not exist")
+  endif()
+  get_target_property(_buildray_unity_type sentencepiece-static TYPE)
+  get_target_property(_buildray_unity_imported sentencepiece-static IMPORTED)
+  get_target_property(_buildray_unity_alias sentencepiece-static ALIASED_TARGET)
+  if(_buildray_unity_imported OR _buildray_unity_alias OR NOT _buildray_unity_type
+     MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
+    message(FATAL_ERROR "Unity requires a local compiled target")
+  endif()
+  set_target_properties(sentencepiece-static PROPERTIES
+    UNITY_BUILD ON UNITY_BUILD_MODE BATCH UNITY_BUILD_BATCH_SIZE 4)
+endif()
