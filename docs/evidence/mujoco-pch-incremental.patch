--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -380,3 +380,21 @@
     endif()
   endforeach()
 endif()
+
+# Buildray: private PCH experiment, validated for the measured configuration.
+if(NOT TARGET mujoco)
+  message(FATAL_ERROR "Buildray PCH target does not exist")
+endif()
+get_target_property(_buildray_pch_type mujoco TYPE)
+get_target_property(_buildray_pch_imported mujoco IMPORTED)
+get_target_property(_buildray_pch_alias mujoco ALIASED_TARGET)
+get_property(_buildray_pch_existing TARGET mujoco PROPERTY PRECOMPILE_HEADERS SET)
+get_property(_buildray_pch_reuse TARGET mujoco PROPERTY PRECOMPILE_HEADERS_REUSE_FROM SET)
+if(_buildray_pch_imported OR _buildray_pch_alias OR _buildray_pch_existing OR _buildray_pch_reuse
+   OR NOT _buildray_pch_type MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
+  message(FATAL_ERROR "Buildray requires a local compiled target without an existing PCH")
+endif()
+set_property(TARGET mujoco PROPERTY DISABLE_PRECOMPILE_HEADERS OFF)
+target_precompile_headers(mujoco PRIVATE
+  "$<$<COMPILE_LANGUAGE:CXX>:${CMAKE_CURRENT_SOURCE_DIR}/include/mujoco/mujoco.h>"
+)
