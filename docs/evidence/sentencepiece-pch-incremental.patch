--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -242,3 +242,21 @@
 set(CPACK_DEBIAN_PACKAGE_MAINTAINER "Taku Kudo")
 set(CPACK_SOURCE_IGNORE_FILES "/build/;/.git/;/dist/;/sdist/;~$;${CPACK_SOURCE_IGNORE_FILES}")
 include(CPack)
+
+# Buildray: private PCH experiment, validated for the measured configuration.
+if(NOT TARGET sentencepiece-static)
+  message(FATAL_ERROR "Buildray PCH target does not exist")
+endif()
+get_target_property(_buildray_pch_type sentencepiece-static TYPE)
+get_target_property(_buildray_pch_imported sentencepiece-static IMPORTED)
+get_target_property(_buildray_pch_alias sentencepiece-static ALIASED_TARGET)
+get_property(_buildray_pch_existing TARGET sentencepiece-static PROPERTY PRECOMPILE_HEADERS SET)
+get_property(_buildray_pch_reuse TARGET sentencepiece-static PROPERTY PRECOMPILE_HEADERS_REUSE_FROM SET)
+if(_buildray_pch_imported OR _buildray_pch_alias OR _buildray_pch_existing OR _buildray_pch_reuse
+   OR NOT _buildray_pch_type MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
+  message(FATAL_ERROR "Buildray requires a local compiled target without an existing PCH")
+endif()
+set_property(TARGET sentencepiece-static PROPERTY DISABLE_PRECOMPILE_HEADERS OFF)
+target_precompile_headers(sentencepiece-static PRIVATE
+  "$<$<COMPILE_LANGUAGE:CXX>:${CMAKE_CURRENT_SOURCE_DIR}/src/common.h>"
+)
